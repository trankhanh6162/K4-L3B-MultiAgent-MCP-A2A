    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "order_ids",
        "claim_ids",
        "evidence_refs",
        "max_new_tool_calls",
        "context",
        "draft"
      ],
      "properties": {
        "task_type": {
          "enum": [
            "resolve_entity",
            "analyze_order",
            "analyze_shipment",
            "analyze_payment",
            "decide_policy",
            "verify"
          ]
        },
        "order_ids": {
          "$ref": "https://day09.vinaction.local/contracts/l3a-output-v2.schema.json#/$defs/idSet"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "evidence_refs": {
          "$ref": "https://day09.vinaction.local/contracts/l3a-output-v2.schema.json#/$defs/evidenceRefs"
        },
        "max_new_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_order_ids",
            "claimed_order_id",
            "customer_unique_id_hint",
            "policy_version"
          ],
          "properties": {
            "candidate_order_ids": {
              "$ref": "https://day09.vinaction.local/contracts/l3a-output-v2.schema.json#/$defs/idSet"
            },
            "claimed_order_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "customer_unique_id_hint": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "draft": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://day09.vinaction.local/contracts/l3b-output-v2.schema.json#"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "verify"
              }
            }
          },
          "then": {
            "properties": {
              "draft": {
                "$ref": "https://day09.vinaction.local/contracts/l3b-output-v2.schema.json#"
              }
            }
          },
          "else": {
            "properties": {
              "draft": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
