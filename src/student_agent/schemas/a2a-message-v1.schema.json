    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "passed",
        "violations",
        "required_followups",
        "evidence_refs"
      ],
      "properties": {
        "result_type": {
          "const": "verification"
        },
        "passed": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "field_path",
              "severity"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "field_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true
        },
        "required_followups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "evidence_refs": {
          "$ref": "https://day09.vinaction.local/contracts/l3a-output-v2.schema.json#/$defs/evidenceRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "required_followups": {
                "maxItems": 0
              },
              "violations": {
                "items": {
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
