{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-agent.local/schemas/a2a-message-v1.schema.json",
  "title": "Internal A2A message V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "run_id",
    "case_id",
    "task_id",
    "in_reply_to",
    "sender",
    "recipient",
    "message_type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "internal-a2a-v1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "in_reply_to": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "sender": {
      "enum": [
        "coordinator",
        "entity-agent",
        "order-agent",
        "shipment-agent",
        "payment-agent",
        "policy-agent",
        "verifier"
      ]
    },
    "recipient": {
      "enum": [
        "coordinator",
        "entity-agent",
        "order-agent",
        "shipment-agent",
        "payment-agent",
        "policy-agent",
        "verifier"
      ]
    },
    "message_type": {
      "enum": [
        "task",
        "result",
        "evidence_request",
        "error"
      ]
    },
    "payload": {}
  },
